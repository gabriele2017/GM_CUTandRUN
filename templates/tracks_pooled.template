#!/bin/sh

prefix="__PREFIX__"
chrom_sizes="/mnt/scratchc/ghlab/gab/REFERENCE/dmelanogaster6/dm6.chrom.sizes"

bam="$prefix/alignment/merged/pooled/$1.bam"

mkdir -p $prefix/tracks_pooled
mkdir -p $prefix/tracks_pooled/bedGraph
mkdir -p $prefix/tracks_pooled/bigWig

printf "$bam\t"
mappedReads=`samtools view -c -F 4 $bam`
printf "$mappedReads\t"
scalingFactor=$(echo "scale=5; 1000000/$mappedReads" | bc)
printf "$scalingFactor\n"
name=`echo $bam | cut -d'/' -f11 | sed -e 's/.bam//'`
bedtools genomecov -ibam $bam -bg -scale $scalingFactor -g $chrom_sizes | grep -v GL | grep -v JH | LC_COLLATE=C sort -k1,1 -k2,2n > $prefix/tracks_pooled/bedGraph/$name.bedGraph
bedGraphToBigWig $prefix/tracks_pooled/bedGraph/$name.bedGraph $chrom_sizes $prefix/tracks_pooled/bigWig/$name.bw

rm $prefix/tracks_pooled/bedGraph/$name.bedGraph
